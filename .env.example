# The API runs from passage_2513.json in memory when DATABASE_URL is unset.
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Local non-production loopback runs serve the team lab automatically. A
# remote preview must opt in explicitly and be access-protected.
ENABLE_TEAM_LAB=true
# Required when ENABLE_TEAM_LAB is enabled in production. Open the remote lab
# once with #access_token=<this value>; the fragment is exchanged for a secure
# HttpOnly cookie and immediately removed from the browser address bar.
TEAM_LAB_ACCESS_TOKEN=

# ClickHouse Managed Postgres runtime connection. A PgBouncer URL is fine for
# ordinary short-lived application queries.
DATABASE_URL=

# Direct Managed Postgres URL for migrations, imports, and ClickPipes setup.
# Do not use a PgBouncer hostname here.
DATABASE_DIRECT_URL=

# Production certificate verification for Managed Postgres.
POSTGRES_CA_CERT_PATH=
# Serverless hosts can store the PEM contents directly instead of a local path.
POSTGRES_CA_CERT=

# ClickHouse Cloud analytics connection.
CLICKHOUSE_URL=
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# Set this only after manually pausing a caught-up ClickPipe when the first
# analytics backfill contains existing events.
CLICKHOUSE_CDC_PAUSED_ACKNOWLEDGED=false
